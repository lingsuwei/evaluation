{
  "description": "onto-agent 默认识别过程点 · 4 条必达基线（Phase1 Agent 注册预置）",
  "source": "docs/M2-过程点配置-onto-agent识别.json",
  "templates": [
    {
      "name": "主 Agent 循环",
      "description": "agent_loop:main",
      "order": 2,
      "required": true,
      "score_weight": 1.0,
      "match_mode": "rule",
      "enabled": true,
      "enforce_order": false,
      "match_rules": {
        "mode": "any",
        "rules": [
          { "type": "observation_name", "op": "eq", "value": "agent_loop:main" }
        ]
      }
    },
    {
      "name": "LLM 推理轮次",
      "description": "llm:main_iteration",
      "order": 3,
      "required": true,
      "score_weight": 1.0,
      "match_mode": "rule",
      "enabled": true,
      "enforce_order": false,
      "match_rules": {
        "mode": "any",
        "rules": [
          { "type": "observation_name", "op": "contains", "value": "llm:main_iteration" }
        ]
      }
    },
    {
      "name": "发生过工具调用",
      "description": "ReAct 至少调用一次内置工具",
      "order": 4,
      "required": true,
      "score_weight": 1.0,
      "match_mode": "rule",
      "enabled": true,
      "enforce_order": false,
      "match_rules": {
        "mode": "any",
        "rules": [
          { "type": "observation_name", "op": "contains", "value": "tool:" }
        ]
      }
    },
    {
      "name": "本体上下文加载",
      "description": "tool:ontology_context",
      "order": 5,
      "required": true,
      "score_weight": 1.0,
      "match_mode": "rule",
      "enabled": true,
      "enforce_order": false,
      "match_rules": {
        "mode": "any",
        "rules": [
          { "type": "observation_name", "op": "eq", "value": "tool:ontology_context" },
          { "type": "metadata", "key": "tool_name", "op": "eq", "value": "ontology_context" }
        ]
      }
    }
  ]
}
