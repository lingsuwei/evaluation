# 本体评测平台环境变量配置
# 复制此文件为 .env 并填入实际的 API Key

# ============================================
# 大模型 API 配置
# ============================================
# 模型配置已迁移至界面管理（数据库存储），以下 .env 变量已废弃：
# GLM_API_KEY / GLM_BASE_URL / GLM_MODEL / DEFAULT_LLM_MODEL

# ============================================
# 数据库配置（独立 PostgreSQL）
# ============================================
# Docker Compose 内 app 容器通过服务名 postgres 连接（端口 5432）：
DATABASE_URL=postgresql+asyncpg://onto_eval:onto_eval_dev@postgres:5432/onto_eval_fact
POSTGRES_USER=onto_eval
POSTGRES_PASSWORD=onto_eval_dev
POSTGRES_DB=onto_eval_fact
POSTGRES_PORT=45432
# 宿主机直连（Alembic / smoke 脚本 / 调试用）：
# DATABASE_URL=postgresql+asyncpg://onto_eval:onto_eval_dev@127.0.0.1:45433/onto_eval_fact

# 回退 SQLite（仅本地调试，不含 Runtime Fact 视图）：
# DATABASE_URL=sqlite+aiosqlite:////app/data/evaluation.db
# ONTO_AGENT_BASE_URL=http://host.docker.internal:5055
# 首次部署：powershell -File scripts/p0-bootstrap.ps1  或  bash scripts/p0-bootstrap.sh
# 冒烟验证：powershell -File scripts/p0-smoke.ps1
# CI 本地预检：bash scripts/ci-check.sh

# ============================================
# 评估指标配置
# ============================================
# 启用的指标，逗号分隔
# 完整列表：faithfulness,answer_relevancy,correctness,inference_latency,tokens_total
ENABLED_METRICS=faithfulness,answer_relevancy,correctness,inference_latency,tokens_total

# 运行时因子阈值（越低越好，超出阈值则该项计 0 分）
# 推理时延阈值（毫秒），300000 = 5 分钟
METRIC_THRESHOLD_INFERENCE_LATENCY_MS=300000
# 总 tokens 阈值，默认 1000000
METRIC_THRESHOLD_TOKENS_TOTAL=1000000

# 场景基于Prompt评测是否启用分段评测（true=分段评测，false=直接一次评测）
SCENARIO_LLM_CHUNK_ENABLED=false

# ============================================
# MCP / 单题评测端点鉴权（可选）
# ============================================
# POST /api/v1/evaluate/single 端点会调用 LLM（产生费用）。
# 设置 EVAL_SINGLE_TOKEN 后，请求须带 X-Eval-Token header 匹配此值；
# 未设置或留空则端点开放（本地开发无负担）。
# MCP 客户端需在 mcp/config.json 的 token 字段填入相同值。
# EVAL_SINGLE_TOKEN=

# ============================================
# Onto Agent 配置 (用于调用 onto-agent API)
# ============================================
# onto-agent 服务地址
# 宿主机直接运行 eval 时用 localhost；Docker Compose 内请改为：
# ONTO_AGENT_BASE_URL=http://host.docker.internal:5055
ONTO_AGENT_BASE_URL=http://localhost:5055

# onto-agent API Token (从 onto-agent 的用户管理中获取)
ONTO_AGENT_API_TOKEN=your_onto_agent_token_here

# onto-agent 工作空间ID (可选)
ONTO_AGENT_WORKSPACE=

# onto-agent 请求超时时间(秒)
ONTO_AGENT_TIMEOUT=1800

# ============================================
# Langfuse 配置 (v2.1 Trace 可观测性)
# ============================================
LANGFUSE_HOST=https://your-langfuse.example.com

# --- 多项目（推荐，约 30 个项目各一对 Key）---
# 方式 1：独立配置文件（推荐，避免 .env 过长）
# langfuse.projects.example.json 默认为空数组，部署后通过系统设置界面添加真实项目
# start.sh / p0-bootstrap 会将其复制到 backend/data/langfuse.projects.json
# Docker 模式：docker-compose.yml 挂载 ./backend/data → /app/data，对应宿主 ./backend/data/langfuse.projects.json
# 本地调试：相对路径 langfuse.projects.json 会解析到项目根目录
LANGFUSE_PROJECTS_FILE=langfuse.projects.json
# 方式 2：JSON 数组写在环境变量（适合项目较少）
# LANGFUSE_PROJECTS=[{"id":"proj-a","name":"项目A","public_key":"pk-lf-...","secret_key":"sk-lf-..."}]

# 默认项目 id：留空则自动取 langfuse.projects.json 中的首项
LANGFUSE_DEFAULT_PROJECT=
# 为 true 时展示名从 Langfuse GET /api/public/projects 同步（失败则用配置中的 name）
LANGFUSE_SYNC_PROJECT_NAMES=true
# 评测埋点写入项目 id（必须与 langfuse.projects.json 中某项 id 一致；留空则用 DEFAULT 或注册表首项）
# 勿填 json 中不存在的 id（如 onto-eval），否则 Trace 埋点不可用
LANGFUSE_WRITE_PROJECT=

# --- 兼容旧版单项目（未配置 LANGFUSE_PROJECTS_* 时生效）---
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# 连接超时秒数（健康检查失败时多为网络/防火墙问题）
LANGFUSE_REQUEST_TIMEOUT=30
# 评测 Pipeline 是否写 onto-eval/* wrapper trace（默认 false；仅 M1 无 task_id 扫 Langfuse 降级需要时可开）
EVAL_LANGFUSE_WRAPPER_ENABLED=false
# Trace 探索：列表每页条数、facets 扫描上限（上千条时由后端聚合筛选项）
TRACE_LIST_PAGE_SIZE=100
TRACE_LIST_PAGE_SIZE_MAX=200
TRACE_FACET_SCAN_PAGE_SIZE=100
TRACE_FACET_SCAN_MAX_ITEMS=5000

# ============================================
# 事实摄入（§11.4 / ADR-027）
# ============================================
# v1.23 起 FACT_INGEST_MODE 已移除：统一使用 Trace Sync Worker 作为唯一物化路径
# Trace Sync Worker 默认开启，评测推理结束后自动拉取 Langfuse trace 并物化
TRACE_SYNC_WORKER_ENABLED=true
# Span 物化是否允许 legacy:type:name 回退（默认 true，C-02；设 false 强制 agent.* 契约）
# BUILDER_ALLOW_LEGACY_AGGREGATE_KEY=true

# Trace Sync Worker 参数
TRACE_SYNC_POLL_INTERVAL_SEC=10
TRACE_SYNC_BATCH_SIZE=20
TRACE_SYNC_MAX_ATTEMPTS=5
# 推理结束后等待多少秒才首次拉取 trace（等 Langfuse 异步落库）
TRACE_SYNC_MIN_INGESTION_DELAY_SEC=30
# 观测数稳定性检查：obs count 连续无变化超过该秒数才认为 trace 上传完成
TRACE_SYNC_STABILITY_WINDOW_SEC=60
# 稳定性检查最大等待秒数，超时后强制处理（即使 obs count 仍在变化）
TRACE_SYNC_MAX_WAIT_SEC=300

# ============================================
# Docker 镜像构建（可选）
# ============================================
# 若 docker build 报错 mirror.aliyuncs.com EOF / failed to resolve metadata，
# 方案 A（推荐）：Docker Desktop → Settings → Docker Engine，删除失效的
#   https://mirror.aliyuncs.com 后 Apply & Restart。
# 方案 B：取消下行注释，经 DaoCloud 等代理拉取基础镜像（见 本体评测平台安装部署.md §镜像构建）
# FRONTEND_BASE_IMAGE=docker.m.daocloud.io/library/node:20-alpine
# PYTHON_BASE_IMAGE=docker.m.daocloud.io/python:3.11-slim

# ============================================
# GitLab / GitCode CI（可选，见 docs/P2.5-部署与CI.md）
# ============================================
# 仓库根 .gitlab-ci.yml 在 MR/分支 push 时跑 ci-check + L1 pytest + frontend build
# 需在 GitCode 仓库设置中启用 Pipeline

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=INFO
LOG_DIR=./backend/logs
LOG_FILE_MAX_SIZE=10
LOG_FILE_BACKUP_COUNT=5
